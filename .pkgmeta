# BigWigs packager: the release zip holds only the add-on.
# media/fonts (Roboto Condensed, Atkinson Hyperlegible Next and their licences), media/icons,
# media/icon.png and media/spacer.png (the tooltip indent) ship.
package-as: Haggler
enable-nolib-creation: no
ignore:
  # V2 (Flips, Ventures): kept in the repo, never shipped. Haggler.toc's do-not-package
  # blocks drop their lines from the release TOC.
  - v2
  - dev
  - tests
  - tools
  - .claude
  - .luacheckrc
  - .stylua.toml
  - .styluaignore
  - media/screenshots
